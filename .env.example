# Public URL of the site. Used for canonical URLs, sitemap, Open Graph, structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: search engine ownership verification (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# MongoDB. Local Compass URI for development; use a MongoDB Atlas URI in production
# (Netlify cannot reach a database running on your computer).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=amxinz

# next-auth  (generate a secret with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ads (full-screen break every 5 predictions)
#   house  = your own sponsor creatives in src/lib/house-ads.ts (default)
#   iframe = ad unit from a network (see "A-ADS setup" in README.md)
#   none   = no ads
NEXT_PUBLIC_AD_PROVIDER=house
# Only the src URL of the iframe, e.g. https://acceptable.a-ads.com/1234567
NEXT_PUBLIC_AD_IFRAME_URL=
# Must match the size you chose when creating the ad unit
NEXT_PUBLIC_AD_IFRAME_WIDTH=300
NEXT_PUBLIC_AD_IFRAME_HEIGHT=250

# Profile photo uploads (https://uploadthing.com -> your app -> API Keys -> copy the token)
UPLOADTHING_TOKEN=

# Email confirmation (https://resend.com -> API Keys)
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
# Until then "Amxinz <onboarding@resend.dev>" only delivers to your own Resend account email.
EMAIL_FROM=Amxinz <onboarding@resend.dev>
